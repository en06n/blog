---
layout: null
---
{
    "version": "https://jsonfeed.org/version/1.1",
    "title": {{ site.title | jsonify }},
    "home_page_url": {{ site.url | jsonify }},
    "feed_url": {{ site.feeds.json | absolute_url | jsonify }},
    "description": {{ site.description | jsonify }},
    "icon": {{ site.logo | img_url | prepend: site.url | jsonify }},
    "favicon": {{ site.favicon | absolute_url | jsonify }},
    "expired": false,
    "language": "en-US",
    "authors": [
        {
            "name": {{ site.author.name | jsonify }},
            "url": {{ site.url | jsonify }},
            "avatar": {{ site.author.avatar | img_url | prepend: site.url | jsonify }}
        }
    ],
    "items": [
        {% for post in site.posts limit: site.feeds.limit %}
        {
            "id": {{ post.url | absolute_url | jsonify }},
            "url": {{ post.url | absolute_url | jsonify }},
            {% if post.subtitle %}
                {% assign title = post.title | append: ": " | append: post.subtitle %}
            {% else %}
                {% assign title = post.title %}
            {% endif %}
            "title": {{ title | jsonify }},
            "date_published": {{ post.date | date_to_xmlschema | jsonify }},
            "date_modified": {{ post.date_updated | default: post.date | date_to_xmlschema | jsonify }},
            "summary": {{ post.excerpt | jsonify }},
            "tags": [
                {% assign tags = post.tags | concat: post.categories %}
                {% for tag in tags %}
                    {{ tag | jsonify }}{% unless forloop.last %},{% endunless %}
                {% endfor %}
            ],
            "content_html": {{ post.content | jsonify }}
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
    ]
}
